  {
    "extends": "./tsconfig.app.json",
    "include": [
      "src/**/*.ts",
      "src/**/*.js",
      "src/**/*.svelte",
      "bindings"
    ],
    "compilerOptions": {
      "paths": {
        "$lib": [
          "./src/lib"
        ],
        "$lib/*": [
          "./src/lib/*"
        ]
      }
    }
  }